#!/usr/bin/env php
<?php
/**
 * Monatsbericht aus einer Messreihe (SQLite, Tabelle `samples`) als JSON.
 *
 *   bin/monatsbericht --db=messreihe.sqlite --monat=2026-10 [--meta=stationen.csv] [--beginn=2026-09-03]
 *
 * stationen.csv (Semikolon, mit Kopfzeile):
 *   station_id;ags;land;betreiber;kw;ladepunkte;aktiv_ab
 * Die letzten beiden Spalten sind optional und erlauben auch Inventar ohne Statusmeldungen.
 * ags = Amtlicher Gemeindeschlüssel des Kreises (5 Stellen), land = 2 Stellen.
 * aktiv_ab = erster aktiver Tag (JJJJ-MM-TT); ohne Angabe gilt der Monatsanfang.
 * Ohne Metadaten gibt es nur die Bundeszahlen und die Dauerstörungen.
 */
require __DIR__ . '/../autoload.php';

use Ladewache\Kennzahlen\Monatsbericht;

$opt = getopt('', ['db:', 'monat:', 'meta::', 'beginn::']);
if (empty($opt['db']) || empty($opt['monat']) || !preg_match('/^\d{4}-\d{2}$/', (string) $opt['monat'])) {
    fwrite(STDERR, "Aufruf: bin/monatsbericht --db=messreihe.sqlite --monat=JJJJ-MM [--meta=stationen.csv] [--beginn=JJJJ-MM-TT]\n");
    exit(2);
}

$pdo = new PDO('sqlite:' . $opt['db'], null, null, [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION]);
[$von, $bis] = Monatsbericht::zeitraum((string) $opt['monat'], isset($opt['beginn']) ? (string) $opt['beginn'] : null);
$scan = Monatsbericht::scan($pdo, $von, $bis);

$meta = [];
if (!empty($opt['meta'])) {
    $datei = (string) $opt['meta'];
    $fh = @fopen($datei, 'r');

    if ($fh === false) {
        fwrite(STDERR, "Metadatendatei kann nicht gelesen werden: {$datei}\n");
        exit(2);
    }

    $kopf = fgetcsv($fh, null, ';', '"', '');
    if ($kopf === false) {
        fclose($fh);
        fwrite(STDERR, "Metadatendatei enthält keine Kopfzeile: {$datei}\n");
        exit(2);
    }

    $kopf = array_map(static fn($feld): string => trim((string) $feld), $kopf);
    $pflichtfelder = ['station_id', 'ags', 'land', 'betreiber', 'kw'];
    $fehlend = array_values(array_diff($pflichtfelder, $kopf));

    if ($fehlend !== [] || count(array_unique($kopf)) !== count($kopf)) {
        fclose($fh);
        $hinweis = $fehlend !== []
            ? 'Fehlende Spalten: ' . implode(', ', $fehlend)
            : 'Die Kopfzeile enthält doppelte Spaltennamen.';
        fwrite(STDERR, "Ungültige Kopfzeile in {$datei}. {$hinweis}\n");
        exit(2);
    }

    $zeilennummer = 1;
    while (($z = fgetcsv($fh, null, ';', '"', '')) !== false) {
        $zeilennummer++;

        if (count($z) === 1 && $z[0] === null) {
            continue;
        }

        if (count($z) !== count($kopf)) {
            fclose($fh);
            fwrite(STDERR, "Ungültige Spaltenzahl in {$datei}, Zeile {$zeilennummer}.\n");
            exit(2);
        }

        $r = array_combine($kopf, $z);
        $stationId = filter_var(trim((string) $r['station_id']), FILTER_VALIDATE_INT);
        $kw = trim((string) $r['kw']);
        $ags = trim((string) $r['ags']);
        $land = trim((string) $r['land']);
        $ladepunkteText = trim((string) ($r['ladepunkte'] ?? ''));
        $aktivAbText = trim((string) ($r['aktiv_ab'] ?? ''));

        $ladepunkte = $ladepunkteText === ''
            ? null
            : filter_var($ladepunkteText, FILTER_VALIDATE_INT);

        $aktivAb = null;
        if ($aktivAbText !== '') {
            $datum = DateTimeImmutable::createFromFormat(
                '!Y-m-d',
                $aktivAbText,
                new DateTimeZone('Europe/Berlin')
            );
            $fehler = DateTimeImmutable::getLastErrors();
            if ($datum === false
                || ($fehler !== false && ($fehler['warning_count'] > 0 || $fehler['error_count'] > 0))
                || $datum->format('Y-m-d') !== $aktivAbText) {
                fclose($fh);
                fwrite(STDERR, "Ungültiges Datum aktiv_ab in {$datei}, Zeile {$zeilennummer}. Erwartet wird JJJJ-MM-TT.\n");
                exit(2);
            }
            $aktivAb = $datum->getTimestamp();
        }

        $kwZahl = $kw === '' ? 0.0 : (is_numeric($kw) ? (float) $kw : -1.0);
        if ($stationId === false || $stationId <= 0
            || ($kw !== '' && (!is_numeric($kw) || !is_finite($kwZahl) || $kwZahl < 0))
            || ($ags !== '' && !preg_match('/^\\d{5}$/', $ags))
            || ($land !== '' && !preg_match('/^\\d{2}$/', $land))
            || ($ags !== '' && $land !== '' && substr($ags, 0, 2) !== $land)
            || ($ladepunkteText !== '' && ($ladepunkte === false || $ladepunkte <= 0))
            || array_key_exists($stationId, $meta)) {
            fclose($fh);
            fwrite(STDERR, "Ungültige oder doppelte Metadaten in {$datei}, Zeile {$zeilennummer}.\n");
            exit(2);
        }

        $meta[$stationId] = [
            'ags' => $ags !== '' ? $ags : null,
            'land' => $land !== '' ? $land : null,
            'op' => trim((string) $r['betreiber']) !== '' ? trim((string) $r['betreiber']) : null,
            'kw' => $kwZahl,
            'ladepunkte' => $ladepunkte,
            'aktiv_ab' => $aktivAb,
            'ort' => null,
            'adresse' => null,
        ];
    }

    fclose($fh);
}

$bericht = Monatsbericht::auswerten($scan['stations'], $meta, [], [], $von, $bis);
$bericht['zeilen'] = $scan['rows'];
echo json_encode($bericht, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES), "\n";
